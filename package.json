{
  "name": "swisstable",
  "version": "0.1.0",
  "description": "WASM-resident SwissTable hash maps (u32 keys) with zero-callback hot paths and bulk transfer APIs",
  "type": "module",
  "license": "MIT",
  "author": "vii",
  "keywords": [
    "swisstable",
    "hashmap",
    "wasm",
    "simd",
    "interner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderDayton/swisstable.git"
  },
  "homepage": "https://github.com/CoderDayton/swisstable#readme",
  "bugs": "https://github.com/CoderDayton/swisstable/issues",
  "main": "./dist/js/index.js",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./swiss_u32.wasm": "./dist/wasm/swiss_u32.wasm",
    "./swiss_u64.wasm": "./dist/wasm/swiss_u64.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/js",
    "dist/wasm",
    "src",
    "native"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:wasm && bun run build:js",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "build:js": "tsc -p tsconfig.build.json",
    "bench": "bun run scripts/bench.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "hooks": "lefthook install",
    "prepublishOnly": "bun run build && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
