      "axis": {
        "title": "speedup against Map",
        "values": [
          0,
          1,
          2,
          3
        ],
        "labelExpr": "datum.value + 'x'",
        "grid": true,
        "gridDash": [
          2,
          3
        ]
      }
    }
  },
