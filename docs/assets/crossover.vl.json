{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the WASM crossing pays for itself",
    "subtitle": "Sparse u32 lookup hit. Above the 1x line the table beats Map. Log scale on entries."
